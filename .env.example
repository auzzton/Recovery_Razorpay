# ── AI Engine — Google Gemini ──────────────────────────────────────────────────
# API key from Google AI Studio: https://aistudio.google.com/app/apikey
# If left blank or invalid, RecoveryOS automatically falls back to the local Heuristic Engine.
GEMINI_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
GEMINI_MODEL=gemini-2.5-flash-lite

# ── Razorpay Integration ──────────────────────────────────────────────────────
# Key ID & Key Secret from Razorpay Dashboard: https://dashboard.razorpay.com/#/app/keys
# Used for real payment status checks and automated payment capture retries.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# ── Payment Recovery URL ──────────────────────────────────────────────────────
# The base URL appended with ?ref=<event_id[:8]> in every outreach message CTA.
# Use a real Razorpay Payment Link, your hosted checkout page, or a redirect handler.
PAYMENT_BASE_URL=https://checkout.example.com/pay

# ── Email — Resend (Primary Email Provider) ───────────────────────────────────
# API key from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxx
# "From" address shown to the customer. Must use a domain verified in Resend.
# Leave unset to fall back to test domain (dev only — will be rejected in production).
RESEND_FROM_EMAIL=RecoveryOS <noreply@yourdomain.com>

# ── Email — SMTP (Alternative Email Provider) ─────────────────────────────────
# Used if RESEND_API_KEY is not set.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_app_password
# SMTP_FROM=your_email@gmail.com

# ── WhatsApp / SMS — Twilio ───────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Your registered Twilio WhatsApp sender number.
# MUST be set explicitly — leaving this unset falls back to simulation (no message sent).
# Do NOT use the shared sandbox number (+14155238886) in production.
TWILIO_FROM_WHATSAPP=+1415XXXXXXX
TWILIO_FROM_SMS=+1415XXXXXXX

# ── Database ──────────────────────────────────────────────────────────────────
# Leave unset for SQLite (recommended for local dev / CI).
# Set to a PostgreSQL connection string for staging and production.
# DATABASE_URL=postgresql://user:password@host:5432/recovery_os

# ── Background Scheduler ──────────────────────────────────────────────────────
# How often the breach-checker and retry executor poll the DB (in minutes).
# Set to 1 for fast local demos; 5 is sensible for production.
SCHEDULER_INTERVAL_MINUTES=5

# ── TRAI Compliance Guards ────────────────────────────────────────────────────
# Maximum payment retry attempts before the workflow is locked as DNC.
MAX_RETRIES=3
# Maximum outreach contacts allowed in a 48-hour window per customer.
MAX_CONTACTS_PER_48H=2

# ── Intervention Costs (paise — 1 INR = 100 paise) ───────────────────────────
# Used in the Expected Value formula: E[Value] = P(recovery) * amount - cost
# Adjust to reflect your actual Twilio and Resend contract pricing.
WHATSAPP_COST_PAISE=500     # ₹5  — default Twilio WhatsApp estimate
VOICE_COST_PAISE=2500       # ₹25 — default Twilio voice call estimate
HUMAN_COST_PAISE=25000      # ₹250 — human agent cost estimate

# ── Counterfactual Baseline ───────────────────────────────────────────────────
# % of failed payments that recover without any intervention (RBI NACH return rate benchmark).
# Used in the dashboard ROI counterfactual panel. Override with merchant-specific historical data.
NATURAL_RECOVERY_RATE=0.12

# ── Frontend — Vite Dev Proxy ─────────────────────────────────────────────────
# Override the proxy target for the Vite dev server (for staging/production).
# Leave unset during local development — defaults to http://127.0.0.1:8000.
# BACKEND_URL=https://your-backend.railway.app
